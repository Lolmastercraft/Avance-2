FROM python:3.12.13-slim
WORKDIR /workspace
COPY requirements-dev.txt requirements.txt /tmp/requirements/
RUN pip install --no-cache-dir -r /tmp/requirements/requirements-dev.txt \
    && pip install --no-cache-dir Flask==3.1.3 Flask-WTF==1.3.0 Flask-Limiter==4.1.1 SQLAlchemy==2.0.54 'psycopg[binary]==3.3.5' gunicorn==26.2.0 Pillow==12.3.0 \
    && python -m venv /opt/runtime \
    && /opt/runtime/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements/requirements.txt
ENV PYTHONIOENCODING=utf-8 PYTHONUTF8=1
